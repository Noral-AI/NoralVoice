# Environment Configuration
ENVIRONMENT="local"
LOG_LEVEL="DEBUG"

# Change these values if you deploy the backend and frontend
# on any hosting provider with some DNS. Please ensure to
# provide the URL with scheme like http or https
BACKEND_API_ENDPOINT="http://localhost:8000"
UI_APP_URL="http://localhost:3000"

# CORS allow-list — comma-separated origins. Wildcards combined with
# credentialed requests are rejected by browsers and unsafe, so this
# must be explicit. Default below covers the UI on :3000 and direct
# API access on :8000 for local development. In production set this to
# the public-facing UI origin(s), e.g. "https://voice.noral.ai".
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"
REDIS_URL="redis://:redissecret@localhost:6379"

# AWS S3 Configuration
ENABLE_AWS_S3="false"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_BUCKET=""
# S3_REGION=""

# MinIO Configuration if using containerised MinIO instead of
# AWS S3
MINIO_ENDPOINT=localhost:9000
# Full URL (with scheme) that browsers use to reach MinIO. Required.
# Remote deployments behind HTTPS: set to e.g. https://your-server.example.com
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=voice-audio
MINIO_SECURE=false

# Tracing and Analytics using Langfuse
# Credentials can be set here or per-organization via the UI at /settings.
# Tracing is automatically active when credentials are available.
# LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# LANGFUSE_HOST="https://cloud.langfuse.com"

# Hidden n8n automation engine
# n8n is server-side only. Do not expose these values to the browser.
N8N_ENABLED="false"
N8N_BASE_URL="https://automation.noral.ai"
# N8N_WEBHOOK_SECRET="replace-with-shared-webhook-secret"
# Optional: only needed for future REST API calls. Webhook triggers are preferred.
# N8N_API_KEY="replace-with-n8n-api-key"
# N8N_TIMEOUT_MS=10000
# N8N_RETRY_COUNT=2

# TURN Server Configuration (for WebRTC NAT traversal)
# Required for reliable WebRTC connections behind firewalls/NAT
# Uses time-limited credentials (TURN REST API) for security
TURN_HOST=localhost
TURN_SECRET=noralvoice-turn-secret-change-in-production
# TURN_PORT=3478  # Default: 3478
# TURN_TLS_PORT=5349  # Default: 5349
# TURN_CREDENTIAL_TTL=86400  # Default: 24 hours in seconds

# --- Credential encryption -------------------------------------------------
# Base64-encoded 32-byte key used to encrypt provider credentials at rest.
# This is the ONLY credential that belongs in the environment: it bears no
# secret itself, and it is what lets every actual provider key live in the
# database under the operator's control rather than in a config file.
#
# Generate one with:
#   python -c "from api.services.crypto import generate_key; print(generate_key())"
#
# Losing it makes existing ciphertext unrecoverable — credentials would have to
# be re-entered in the UI. Back it up with your other deploy secrets.
#
# Leaving it unset is safe until the data migration runs: rows written before
# encryption existed still read correctly without a key.
# CREDENTIAL_ENCRYPTION_KEY=""

# --- ElevenLabs ------------------------------------------------------------
# NOTE: there is deliberately no ELEVENLABS_API_KEY here. The API key is
# entered per organization in the platform UI (Settings -> Voice provider) and
# stored encrypted. Every call resolves it from the calling organization or
# fails; there is no environment fallback, by design.
#
# This is the vendor's webhook SIGNING secret, which authenticates ElevenLabs
# to us. It cannot be used to call ElevenLabs.
# ELEVENLABS_WEBHOOK_SECRET=""
