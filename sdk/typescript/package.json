{
  "name": "@noralai/voice-sdk",
  "version": "0.4.0",
  "description": "Typed builder for NoralVoice voice-AI workflows",
  "license": "BSD-2-Clause",
  "author": "Noral AI <support@noral.ai>",
  "homepage": "https://noral.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Noral-AI/NoralVoice.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "noralvoice",
    "voice-ai",
    "workflow",
    "sdk",
    "llm",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./typed": {
      "types": "./dist/typed/index.d.ts",
      "import": "./dist/typed/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "codegen": "node scripts/codegen.mts --api http://localhost:8000 --out src/typed",
    "test": "tsc && node --test --test-reporter=spec tests/sdk.test.mts tests/typed.test.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.3.0"
  }
}
